package web

import "harness/surface/web/ui"

const appearanceSectionID = "appearance"

templ Page(products []Product, currentID string, navigation templ.Component, content templ.Component) {
	<!DOCTYPE html>
	<html lang="zh-CN">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Harness</title>
			<script src="/static/theme.js"></script>
			<link rel="stylesheet" href="/static/site.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/htmx-ext-sse.js"></script>
			<script src="/static/vendor/marked.umd.js"></script>
			<script src="/static/vendor/purify.min.js"></script>
		</head>
		<body class="ui-page">
			<div class="min-h-screen p-2">
				<div id="app-shell" class="ui-shell flex h-[calc(100vh-1rem)] overflow-hidden">
					<aside id="sidebar" class="ui-panel flex shrink-0 flex-col border-r border-[var(--ui-color-border)] p-3">
						<div class="sidebar-brand mb-5 flex items-center justify-between gap-2 px-1">
							<a href="/" class="flex items-center gap-2 ui-text-body font-semibold no-underline" aria-label="Harness 首页">
							<span class="ui-brand-mark">H</span>
								<span class="sidebar-label">Harness</span>
							</a>
							<button id="sidebar-toggle" type="button" aria-label="收起侧栏" aria-expanded="true" class="ui-icon-button">@ui.Icon(ui.IconSidebar)</button>
						</div>
						@ProductLinks(products, currentID, false)
						@ProductNavigation(navigation)
						<div class="mt-auto border-t border-[var(--ui-color-border)] pt-3">
							<a
								href="/settings"
								hx-get="/settings"
								hx-target="#main"
								hx-swap="outerHTML"
								hx-push-url="true"
								class="ui-nav-item"
								if currentID == "settings" {
									aria-current="page"
								}
							>
								@ui.Icon(ui.IconSettings)
								<span class="sidebar-label">设置</span>
							</a>
						</div>
					</aside>
					@Main(content)
				</div>
			</div>
			<script src="/static/sidebar.js"></script>
		</body>
	</html>
}

templ ProductNavigation(content templ.Component) {
	<div id="product-navigation" class="mt-4 min-h-0 flex-1 overflow-y-auto border-t border-[var(--ui-color-border)] pt-3">
		@content
	</div>
}

templ ProductLinks(products []Product, currentID string, oob bool) {
	<nav
		id="product-links"
		aria-label="产品"
		class="space-y-1"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		for _, product := range products {
			<a
				href={ templ.SafeURL(product.BasePath) }
				hx-get={ templ.URL(product.BasePath) }
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
				class="ui-nav-item"
				if product.ID == currentID {
					aria-current="page"
				}
			>
				@ui.Icon(product.Icon)
				<span class="sidebar-label">{ product.Name }</span>
			</a>
		}
	</nav>
}

templ ProductFragment(products []Product, currentID string, navigation templ.Component, content templ.Component) {
	@ProductLinks(products, currentID, true)
	<div id="product-navigation" hx-swap-oob="outerHTML" class="mt-4 min-h-0 flex-1 overflow-y-auto border-t border-[var(--ui-color-border)] pt-3">
		@navigation
	</div>
	@Main(content)
}

templ Main(content templ.Component) {
	<main id="main" class="min-h-0 min-w-0 flex-1 overflow-hidden bg-[var(--ui-color-surface)]">
		@content
	</main>
}

templ SettingsPage(sections []SettingsSectionDefinition, currentSectionID string, content templ.Component) {
	<div id="settings-page" class="flex h-full min-h-0">
		<aside class="ui-panel flex w-56 shrink-0 flex-col border-r border-[var(--ui-color-border)] p-4">
			<h2 class="ui-text-section mb-3">设置</h2>
			@SettingsNav(sections, currentSectionID, false)
		</aside>
		<section id="settings-content" class="min-h-0 flex-1 overflow-y-auto bg-[var(--ui-color-surface)] p-8">
			@content
		</section>
	</div>
}

templ SettingsNav(sections []SettingsSectionDefinition, currentSectionID string, oob bool) {
	<nav
		id="settings-nav"
		aria-label="设置栏目"
		class="space-y-1"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		<a
			href="/settings/appearance"
			hx-get="/settings/appearance"
			hx-target="#settings-content"
			hx-swap="innerHTML"
			hx-push-url="true"
			class="ui-nav-item"
			if currentSectionID == appearanceSectionID {
				aria-current="page"
			}
		>
			@ui.Icon(ui.IconSettings)
			外观
		</a>
		if len(sections) == 0 {
			<p class="px-3 py-1 ui-text-meta">暂无插件设置</p>
		} else {
			for _, section := range sections {
				<a
					href={ templ.SafeURL("/settings/" + section.ID) }
					hx-get={ templ.URL("/settings/" + section.ID) }
					hx-target="#settings-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					class="ui-nav-item"
					if section.ID == currentSectionID {
						aria-current="page"
					}
				>
					{ section.Title }
				</a>
			}
		}
	</nav>
}

templ SettingsContentFragment(sections []SettingsSectionDefinition, currentSectionID string, content templ.Component) {
	@SettingsNav(sections, currentSectionID, true)
	@content
}

templ SettingsAppearance() {
	<div class="max-w-xl space-y-6">
		<header class="space-y-1">
			<h3 class="ui-text-title">外观</h3>
			<p class="ui-text-meta">主题只保存在当前浏览器，不会写入会话或项目数据。</p>
		</header>
		<section class="ui-card space-y-4 p-5">
			<div class="space-y-1.5">
				<label for="theme-select" class="ui-text-meta">界面主题</label>
				<select id="theme-select" class="ui-select">
					<option value="system" selected>跟随系统</option>
					<option value="light">亮色</option>
					<option value="dark">暗色</option>
				</select>
			</div>
			<p class="ui-text-meta">选择暗色或亮色后，所有 Web 产品和插槽会使用同一套主题 Token。</p>
		</section>
	</div>
}

templ SettingsEmpty() {
	<div class="ui-empty-state">
		<div>
			<div class="mx-auto mb-3 ui-text-section" aria-hidden="true">@ui.Icon(ui.IconSettings)</div>
			<p class="ui-text-body font-semibold">暂无可用设置</p>
			<p class="mt-1 ui-text-meta">当前没有插件登记设置项。</p>
		</div>
	</div>
}

templ SettingsNotFound() {
	<div class="ui-empty-state">
		<p class="ui-notice ui-notice-danger">未找到该插件设置</p>
	</div>
}

templ SettingsRenderError() {
	<div class="ui-empty-state">
		<p class="ui-notice ui-notice-danger">设置项暂时无法加载</p>
	</div>
}
