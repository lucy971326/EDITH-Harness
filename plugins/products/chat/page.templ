package chat

templ ChatPage(data pageView) {
	<div class="flex min-h-[calc(100vh-1rem)] flex-col">
		<header class="flex h-16 items-center justify-between border-b border-[var(--color-border)] px-6">
			<div>
				if data.HasActive {
					<h1 class="text-sm font-semibold">{ data.Selected.Title }</h1>
				} else {
					<h1 class="text-sm font-semibold">对话</h1>
				}
				if data.HasActive {
					<p class="mt-0.5 text-xs text-[var(--color-subtle)]">{ data.Selected.CreatedAt.Format("2006-01-02 15:04") }</p>
				} else {
					<p class="mt-0.5 text-xs text-[var(--color-subtle)]">按工作区目录分组</p>
				}
			</div>
			<div class="flex gap-5 text-sm">
				<span class="border-b-2 border-[var(--color-accent)] pb-1 font-medium">对话</span>
				<span class="pb-1 text-[var(--color-subtle)]">轨迹</span>
			</div>
		</header>
		if data.HasActive {
			<section id="chat-root" class="flex flex-1 flex-col px-6 pb-36" hx-ext="sse" sse-connect={ templ.URL("/chat/" + data.Selected.ID + "/events") } data-history={ templ.URL("/chat/" + data.Selected.ID + "/history") }>
				<div id="thread" class="mx-auto w-full max-w-3xl space-y-3 py-6"></div>
				<p id="chat-status" class="mx-auto w-full max-w-3xl text-sm text-[var(--color-subtle)]"></p>
				<div sse-swap="run" hidden></div>
			</section>
		} else {
			<section class="flex flex-1 items-center justify-center px-6 pb-36">
				<div class="max-w-md text-center">
					<div class="mx-auto mb-4 grid size-11 place-items-center rounded-2xl bg-[var(--color-muted)] text-lg">H</div>
					if data.Error != "" {
						<h2 class="text-lg font-semibold">无法创建项目</h2>
						<p class="mt-2 text-sm leading-6 text-red-700">{ data.Error }</p>
					} else {
						<h2 class="text-lg font-semibold">创建一个项目开始对话</h2>
						<p class="mt-2 text-sm leading-6 text-[var(--color-subtle)]">项目会按工作区目录分组。</p>
					}
				</div>
			</section>
		}
		if data.HasActive {
			<div class="pointer-events-none absolute bottom-6 left-1/2 w-[min(760px,calc(100%_-_3rem))] -translate-x-1/2">
				<form id="composer" action={ templ.URL("/chat/" + data.Selected.ID + "/messages") } method="post" class="pointer-events-auto rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-3 shadow-sm">
					<textarea name="text" rows="2" aria-label="消息" placeholder="输入消息" class="w-full resize-none border-0 bg-transparent px-1 text-sm outline-none placeholder:text-[var(--color-subtle)]"></textarea>
					<div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-[var(--color-subtle)]">
						<select name="model" id="model" class="rounded border border-[var(--color-border)] bg-white px-2 py-1" disabled?={ data.Model != "" }>
							<option value="">选择模型</option>
							for _, model := range data.Models {
								<option value={ model.ID } selected?={ data.Model == model.ID }>{ model.ID }</option>
							}
						</select>
						<select name="reasoningEffort" id="reasoning-effort" class="rounded border border-[var(--color-border)] bg-white px-2 py-1" disabled?={ data.ReasoningEffort != "" }>
							<option value="">选择思考档位</option>
							for _, model := range data.Models {
								for _, effort := range model.ReasoningEfforts {
									<option value={ effort } data-model={ model.ID } selected?={ data.ReasoningEffort == effort }>{ effort }</option>
								}
							}
						</select>
						<select id="live-mode" name="mode" class="hidden rounded border border-[var(--color-border)] bg-white px-2 py-1">
							<option value="steer">插话 Steer</option>
							<option value="followup">下一轮 FollowUp</option>
						</select>
						<button id="send-button" name="mode" value="run" type="submit" class="ml-auto rounded-lg bg-[var(--color-accent)] px-4 py-2 font-medium text-white">发送</button>
						<button id="live-send" type="submit" class="hidden rounded-lg border border-[var(--color-border)] px-4 py-2 font-medium">提交</button>
						<button id="stop-button" type="button" data-stop={ templ.URL("/chat/" + data.Selected.ID + "/stop") } class="hidden rounded-lg bg-red-700 px-4 py-2 font-medium text-white">停止</button>
					</div>
				</form>
			</div>
			<script src="/static/chat.js"></script>
		}
	</div>
}

templ ChatNavigation(data pageView) {
	<div class="mb-3 flex items-center justify-between text-sm font-semibold">
		<span>项目</span>
		<form method="post" action="/chat/projects">
			<button type="submit" aria-label="新建项目" class="rounded px-2 py-1 hover:bg-white">＋</button>
		</form>
	</div>
	for _, project := range data.Projects {
		<section class="mb-3">
			<p class="truncate px-2 text-xs font-medium text-[var(--color-subtle)]" title={ project.Workspace }>{ project.Name }</p>
			for _, item := range project.Sessions {
				<a
					href={ templ.SafeURL("/chat/" + item.ID) }
					hx-get={ templ.URL("/chat/" + item.ID) }
					hx-target="#main"
					hx-swap="outerHTML"
					hx-push-url="true"
					class={ "mt-1 block truncate rounded px-2 py-1.5 text-sm hover:bg-white", templ.KV("bg-white font-medium", data.HasActive && data.Selected.ID == item.ID) }
				>{ item.Title }</a>
			}
		</section>
	}
}
