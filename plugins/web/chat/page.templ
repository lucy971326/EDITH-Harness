package chat

import (
	"harness/surface/web/runview"
	"harness/surface/web/ui"
)

templ ChatPage(data pageView) {
	<div id="chat-page" class="flex h-full min-h-0">
		<div class="flex min-w-0 flex-1 flex-col">
			<header class="flex h-16 shrink-0 items-center justify-between border-b border-[var(--ui-color-border)] px-6">
				<div>
					if data.HasActive {
						<h1 class="ui-text-section">{ data.Selected.Title }</h1>
					} else {
						<h1 class="ui-text-section">对话</h1>
					}
					if data.HasActive {
						<p class="mt-1 ui-text-meta">{ data.Selected.CreatedAt.Format("2006-01-02 15:04") }</p>
					} else {
						<p class="mt-1 ui-text-meta">按工作区目录分组</p>
					}
				</div>
				<div class="flex items-center gap-1 ui-text-body">
					<span class="ui-tab ui-tab-active">对话</span>
					<span class="ui-tab">轨迹</span>
					if data.HasActive {
						<button id="panel-toggle" type="button" aria-label="打开面板" aria-expanded="false" class="ui-icon-button">@ui.Icon(ui.IconPanel)</button>
					}
				</div>
			</header>
			if data.HasActive {
				<section id="chat-root" class="flex min-h-0 flex-1 flex-col" hx-ext="sse" sse-connect={ templ.URL("/chat/" + data.Selected.ID + "/events") } data-message-actions={ data.MessageActionsJSON } data-message-action-url={ templ.URL("/chat/" + data.Selected.ID + "/message-actions/") } data-suggestions-url={ templ.URL("/chat/" + data.Selected.ID + "/suggestions") }>
					<section class="flex min-h-0 flex-1 flex-col overflow-y-auto px-6">
						@runview.View(runview.Config{
							ID:          "chat-run",
							SnapshotURL: "/chat/" + data.Selected.ID + "/history",
							AutoScroll:  true,
						})
						<p id="chat-status" class="mx-auto w-full max-w-3xl ui-text-meta"></p>
					</section>
					if len(data.Docks) > 0 {
						<section id="dock" class="mx-auto w-full max-w-3xl px-6 pb-3">
							for _, dock := range data.Docks {
								<details class="ui-disclosure ui-text-body">
									<summary class="cursor-pointer font-medium">{ dock.Definition.Name }</summary>
									<div class="ui-disclosure-content pt-2" sse-swap={ "dock-" + dock.Definition.ID }>
										@dock.Content
									</div>
								</details>
							}
						</section>
					}
					<div class="shrink-0 px-6 pb-6">
						<form id="composer" action={ templ.URL("/chat/" + data.Selected.ID + "/messages") } method="post" class="ui-card ui-composer mx-auto w-full max-w-3xl p-3">
							<template id="message-skill-template">
								<span class="ui-message-skill">
									@ui.Icon(ui.IconSkill)
									<span data-message-skill-name></span>
								</span>
							</template>
							<div id="composer-suggestions" class="ui-menu ui-suggestion-popover" hidden role="listbox" aria-label="输入候选">
								<div id="skill-suggestion-items">
									@SuggestionItems(data.Suggestions)
								</div>
							</div>
							<textarea name="text" rows="2" aria-label="消息" placeholder="输入消息" class="ui-textarea border-0 bg-transparent px-1 py-1 resize-none"></textarea>
							<div class="mt-2 flex flex-wrap items-center gap-2 ui-text-meta">
								if len(data.ComposerActions) > 0 {
									<div id="composer-actions" class="flex items-center gap-1.5">
										for _, action := range data.ComposerActions {
											@action.Content
										}
									</div>
								}
								<select name="agentID" id="agent" class="ui-select w-auto">
									for _, agent := range data.Agents {
										<option value={ agent.ID } selected?={ data.AgentID == agent.ID }>{ agent.Name }</option>
									}
								</select>
								<select name="model" id="model" class="ui-select w-auto">
									<option value="">选择模型</option>
									for _, model := range data.Models {
										<option value={ model.ID } selected?={ data.Model == model.ID }>{ model.ID }</option>
									}
								</select>
								<select name="reasoningEffort" id="reasoning-effort" class="ui-select w-auto">
									<option value="">选择思考档位</option>
									for _, model := range data.Models {
										for _, effort := range model.ReasoningEfforts {
											<option value={ effort } data-model={ model.ID } selected?={ data.Model == model.ID && data.ReasoningEffort == effort }>{ effort }</option>
										}
									}
								</select>
								<select id="live-mode" name="mode" class="ui-select w-auto hidden">
									<option value="steer">插话 Steer</option>
									<option value="followup">下一轮 FollowUp</option>
								</select>
								<button id="send-button" name="mode" value="run" type="submit" class="ui-button-primary ml-auto">发送</button>
								<button id="live-send" type="submit" class="ui-button-secondary ml-auto hidden">提交</button>
								<button id="stop-button" type="button" data-stop={ templ.URL("/chat/" + data.Selected.ID + "/stop") } class="ui-button-danger hidden">停止</button>
							</div>
						</form>
					</div>
				</section>
				<script src="/assets/chat/chat.js"></script>
			} else {
				<section class="flex min-h-0 flex-1 items-center justify-center px-6">
					<div class="max-w-md text-center">
						<div class="ui-brand-mark mx-auto mb-4">H</div>
						if data.Error != "" {
							<h2 class="ui-text-section">无法创建项目</h2>
							<p class="ui-notice ui-notice-danger mt-2">{ data.Error }</p>
						} else {
							<h2 class="ui-text-section">创建一个项目开始对话</h2>
							<p class="mt-2 ui-text-body">项目会按工作区目录分组。</p>
						}
					</div>
				</section>
			}
		</div>
		if data.HasActive {
			<aside id="sidepanel" hidden class="ui-sidepanel relative flex h-full shrink-0 border-l border-[var(--ui-color-border)]" style="width: 420px" data-panel-url={ templ.URL("/chat/" + data.Selected.ID + "/panels/") }>
				<div id="panel-resize-handle" class="absolute inset-y-0 -left-1 w-2 cursor-col-resize" aria-label="调节面板宽度"></div>
				<div class="flex min-w-0 flex-1 flex-col">
					<header class="flex h-16 shrink-0 items-center gap-2 border-b border-[var(--ui-color-border)] px-3">
						<div id="panel-tabs" class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto"></div>
						<div class="relative">
							<button id="panel-add" type="button" aria-label="打开面板" aria-expanded="false" class="ui-icon-button">@ui.Icon(ui.IconPlus)</button>
							<div id="panel-menu" hidden class="ui-menu absolute right-0 top-10 z-10 w-44">
								for _, panel := range data.Panels {
									<button type="button" class="panel-menu-item ui-menu-item ui-text-body" data-panel-type={ panel.ID } data-panel-instance={ panel.DefaultInstanceKey } data-panel-title={ panel.DefaultTabTitle }>@ui.Icon(panel.Icon) { panel.Name }</button>
								}
							</div>
						</div>
						<button id="panel-close" type="button" aria-label="关闭面板" class="ui-icon-button">@ui.Icon(ui.IconClose)</button>
					</header>
					<div id="panel-content" class="min-h-0 flex-1 overflow-auto">
						<div class="ui-panel-empty ui-text-body">从 + 打开一个面板</div>
					</div>
				</div>
			</aside>
			<script src="/assets/chat/sidepanel.js"></script>
		}
	</div>
}

templ ChatNavigation(data pageView) {
	<div class="mb-3 flex items-center justify-between ui-text-section">
		<span>项目</span>
		<form method="post" action="/chat/projects">
			<button type="submit" aria-label="新建项目" class="ui-icon-button">@ui.Icon(ui.IconPlus)</button>
		</form>
	</div>
	for _, project := range data.Projects {
		<section class="mb-3">
			<div class="flex items-center justify-between gap-2 px-2">
				<p class="ui-text-meta min-w-0 truncate font-semibold" title={ project.Workspace }>{ project.Name }</p>
				if len(project.Sessions) > 0 {
					<form method="post" action={ templ.URL("/chat/" + project.Sessions[0].ID + "/sessions") }>
						<button type="submit" aria-label={ "在 " + project.Name + " 新建对话" } title="新建对话" class="ui-icon-button">@ui.Icon(ui.IconPlus)</button>
					</form>
				}
			</div>
			for _, item := range project.Sessions {
				<a
					href={ templ.SafeURL("/chat/" + item.ID) }
					hx-get={ templ.URL("/chat/" + item.ID) }
					hx-target="#main"
					hx-swap="outerHTML"
					hx-push-url="true"
					class="ui-nav-item mt-1 truncate"
					if data.HasActive && data.Selected.ID == item.ID {
						aria-current="page"
					}
				>{ item.Title }</a>
			}
		</section>
	}
}

templ DockRenderError() {
	<p class="ui-notice ui-notice-danger ui-text-meta">暂时无法加载</p>
}

templ SuggestionItems(items []Suggestion) {
	for _, item := range items {
		<button type="button" class="ui-menu-item ui-suggestion-item" role="option" data-suggestion-name={ item.Name } data-suggestion-source-id={ item.SourceID }>
			@ui.Icon(item.Icon)
			<span class="ui-suggestion-name">{ item.Name }</span>
			<span class="ui-suggestion-description" title={ item.Description }>{ item.Description }</span>
			<span class="ui-suggestion-scope">{ item.Scope }</span>
		</button>
	}
	if len(items) == 0 {
		<p class="ui-suggestion-empty ui-text-meta">没有可用 Skill</p>
	}
}
