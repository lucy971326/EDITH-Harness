package demo

import "harness/surface/web/ui"

templ content() {
	<div class="grid h-full place-items-center p-6 text-center">
		<div>
			<div class="ui-brand-mark mx-auto mb-3">@ui.Icon(ui.IconPanel)</div>
			<p class="ui-text-body font-semibold">面板登记已就绪</p>
			<p class="mt-1 ui-text-meta">这是独立 demo 插件填入的内容。</p>
		</div>
	</div>
}
