package agents

import "harness/kernel/agents"

templ AgentSettings(data agentSettingsView) {
	<div id="agent-settings" class="flex min-h-full min-w-0 flex-col gap-6 lg:flex-row">
		<aside class="w-full shrink-0 lg:w-52">
			<div class="mb-3 flex items-center justify-between">
				<p class="ui-text-section">Agent</p>
				<a href="/settings/agents/new" hx-get="/settings/agents/new" hx-target="#agent-settings" hx-swap="outerHTML" class="ui-button-secondary">新建</a>
			</div>
			<nav class="space-y-1" aria-label="Agent 列表">
				for _, agent := range data.Agents {
					<a href={ templ.SafeURL("/settings/agents/" + agent.ID) } hx-get={ templ.URL("/settings/agents/" + agent.ID) } hx-target="#agent-settings" hx-swap="outerHTML" class="ui-nav-item" if agent.Selected { aria-current="page" }>
						<span class="min-w-0 flex-1 truncate">{ agent.Name }</span>
						if agent.InUse {
							<span class="ui-text-meta">使用中</span>
						}
					</a>
				}
			</nav>
		</aside>
		<section class="min-w-0 flex-1 max-w-3xl">
			<header class="mb-6 space-y-1">
				<h3 class="ui-text-title">{ agentTitle(data.Selected, data.IsNew) }</h3>
				if data.IsNew {
					<p class="ui-text-meta">新 Agent 从空的 Tool 与 Skill 名单开始，请按需要明确选择。</p>
				} else if data.Selected.ID == agents.DefaultID {
					<p class="ui-text-meta">新会话默认使用此 Agent。它可以编辑，但不可删除。</p>
				} else {
					<p class="ui-text-meta">修改会在下一轮 Run 生效；不会影响正在运行的任务。</p>
				}
			</header>
			if data.Error != "" {
				<p class="ui-notice ui-notice-danger mb-4">{ data.Error }</p>
			}
			<form
				if data.IsNew {
					action="/settings/agents"
					hx-post="/settings/agents"
				} else {
					action={ templ.URL("/settings/agents/" + data.Selected.ID) }
					hx-post={ templ.URL("/settings/agents/" + data.Selected.ID) }
				}
				hx-target="#agent-settings"
				hx-swap="outerHTML"
				class="ui-card space-y-6 p-5"
			>
				<div>
					<label for="agent-name" class="ui-text-meta">名称</label>
					<input id="agent-name" name="name" required value={ data.Selected.Name } class="ui-input mt-1.5" placeholder="例如：代码审查"/>
				</div>
				<div>
					<label for="agent-kind" class="ui-text-meta">工作流</label>
					<select id="agent-kind" name="kind" class="ui-select mt-1.5">
						for _, loop := range data.Choices.Loops {
							<option value={ loop.Kind } selected?={ data.Selected.Kind == loop.Kind }>{ loop.Kind } — { loopDescription(loop) }</option>
						}
					</select>
				</div>
				<div>
					<label for="agent-system-prompt" class="ui-text-meta">系统提示词</label>
					<textarea id="agent-system-prompt" name="systemPrompt" rows="7" class="ui-textarea mt-1.5">{ data.Selected.SystemPrompt }</textarea>
				</div>
				<fieldset>
					<legend class="ui-text-body font-semibold">允许使用的 Tool</legend>
					<p class="mt-1 ui-text-meta">只有勾选的 Tool 会提供给此 Agent。</p>
					<div class="mt-3 divide-y divide-[var(--ui-color-border)] border-y border-[var(--ui-color-border)]">
						for _, tool := range data.Choices.Tools {
							<label class="flex cursor-pointer items-start gap-3 py-3 ui-text-body">
								<input type="checkbox" name="tools" value={ tool.Name } checked?={ selectedName(data.Selected.Tools, tool.Name) } class="ui-checkbox mt-1"/>
								<span><span class="font-medium">{ tool.Name }</span><span class="mt-0.5 block ui-text-meta">{ toolDescription(tool) }</span></span>
							</label>
						}
					</div>
				</fieldset>
				<fieldset>
					<legend class="ui-text-body font-semibold">启用的 Skill</legend>
					<p class="mt-1 ui-text-meta">Skill 摘要会加入此 Agent 的系统提示词。</p>
					<div class="mt-3 divide-y divide-[var(--ui-color-border)] border-y border-[var(--ui-color-border)]">
						for _, skill := range data.Choices.Skills {
							<label class="flex cursor-pointer items-start gap-3 py-3 ui-text-body">
								<input type="checkbox" name="skills" value={ skill.Name } checked?={ selectedName(data.Selected.Skills, skill.Name) } class="ui-checkbox mt-1"/>
								<span><span class="font-medium">{ skill.Name }</span><span class="mt-0.5 block ui-text-meta">{ skillSummary(skill) }</span></span>
							</label>
						}
					</div>
				</fieldset>
				<div class="flex items-center gap-3">
					<button type="submit" class="ui-button-primary">保存 Agent</button>
					if !data.IsNew && data.Selected.ID != agents.DefaultID {
						if data.SelectedInUse {
							<span class="ui-text-meta">正在被会话使用，无法删除。</span>
						} else {
							<span class="ui-text-meta">删除前会检查是否仍被会话使用。</span>
						}
					}
				</div>
			</form>
			if !data.IsNew && data.Selected.ID != agents.DefaultID && !data.SelectedInUse {
				<form action={ templ.URL("/settings/agents/" + data.Selected.ID + "/delete") } method="post" hx-post={ templ.URL("/settings/agents/" + data.Selected.ID + "/delete") } hx-target="#agent-settings" hx-swap="outerHTML" class="mt-3">
					<button type="submit" class="ui-button-danger">删除 Agent</button>
				</form>
			}
		</section>
	</div>
}
